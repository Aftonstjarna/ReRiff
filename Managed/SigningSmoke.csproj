<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net45</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>ReRiff.snk</AssemblyOriginatorKeyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WarningsAsErrors>CS8002</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SigningSmoke.cs" />
    <Compile Include="NativeReelBridgeSmoke.cs" />
    <Compile Include="ClientNewsSmoke.cs" />
    <Reference Include="System.Web.Extensions" />
    <ProjectReference Include="../ClientConfig/ClientConfig.csproj" />
    <ProjectReference Include="../NewsHeaders/NewsHeaders.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net45" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
