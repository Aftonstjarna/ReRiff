[server]
; External server example: https://riffapi.hobune.stream/
; To use it, set external_url = https://riffapi.hobune.stream/
external_url =
; Optional secondary Docker/Podman server. Neither available selects singleplayer.
fallback_url =
timeout_seconds = 5
external_only = false
; false selects singleplayer without probing servers; addresses are retained.
networking_enabled = true
show_server_popup = true

[launcher]
; Shared with the in-game Skip launcher switch.
skip_launcher = false
; Check the installed release channel before starting without the launcher.
auto_update_on_skip = false

[graphics]
; Experimental native Graphics-menu setting; Off by default.
antialiasing = false
; Keep a monitor-sized borderless window while choosing the render resolution.
borderless = false
; render_width, render_height and exclusive_fullscreen are written after
; confirming a display change in the native Keep/Revert screen.
