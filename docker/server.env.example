# Both addresses reach one server and the same ./data directory.
RERIFF_PUBLIC_URL=https://reriff.example.net
RERIFF_LAN_URL=http://192.0.2.10:5144
# Do not set RERIFF_MIGRATE_FROM_ORIGIN when both addresses coexist.

# Balance defaults from the local singleplayer.ini [balance] example.
# Policy preview by default; trusted progression uses these settings without anticheat.
# Recreate the server after edits: docker compose up -d --force-recreate server
RERIFF_BALANCE_COIN_REWARD_RATE=1
RERIFF_BALANCE_CREATOR_REWARD_RATE=1
RERIFF_BALANCE_PRESTIGE_MULTIPLIER_GROWTH=1
# 0 means no prestige multiplier cap; otherwise use a value >= 1.
RERIFF_BALANCE_PRESTIGE_MULTIPLIER_CAP=0
RERIFF_BALANCE_PAINT_PRICE_SCALE=1

# 20% at level 10, then +5 percentage points every 5 levels, up to 50%.
RERIFF_BALANCE_DISCOUNT_MODE=interval
RERIFF_BALANCE_DISCOUNT_START_LEVEL=10
RERIFF_BALANCE_DISCOUNT_START=0.20
RERIFF_BALANCE_DISCOUNT_INTERVAL=5
RERIFF_BALANCE_DISCOUNT_INCREASE=0.05
RERIFF_BALANCE_DISCOUNT_MAXIMUM=0.50
# Used when DISCOUNT_MODE=legacy (10/20/30 milestones, then diminishing gap).
RERIFF_BALANCE_DISCOUNT_LEVEL_10=0.10
RERIFF_BALANCE_DISCOUNT_LEVEL_20=0.20
RERIFF_BALANCE_DISCOUNT_LEVEL_30=0.25
RERIFF_BALANCE_DISCOUNT_REMAINING_GAP_FACTOR=0.5

# 0 cap means uncapped; 0 XP step uses the native level 39-to-40 cost.
RERIFF_BALANCE_MAIN_LEVEL_CAP=0
RERIFF_BALANCE_MAIN_LEVEL_XP_STEP=0
RERIFF_BALANCE_MAIN_LEVEL_XP_GROWTH=1

# Additional server policy settings; unchanged from the original preview defaults.
RERIFF_BALANCE_MAIN_XP_RATE=1
RERIFF_BALANCE_PRESTIGE_XP_RATE=1
RERIFF_BALANCE_SEASON=default
RERIFF_BALANCE_ANTI_CHEAT=disabled
RERIFF_BALANCE_CAR_LEVELS='{}'
RERIFF_BALANCE_REQUIRED_ACHIEVEMENTS=native_all
# null means unlimited; 0 explicitly disallows further prestige resets.
RERIFF_BALANCE_MAXIMUM_PRESTIGE_COUNT=null

# Experimental authenticated checkpoints; trusted clients only (no anticheat).
RERIFF_PROGRESSION_MODE=disabled
